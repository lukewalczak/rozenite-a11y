{
  "name": "rozenite-a11y",
  "version": "0.1.2",
  "description": "Accessibility inspector for React Native DevTools, built on Rozenite.",
  "license": "MIT",
  "homepage": "https://github.com/lukewalczak/rozenite-a11y#readme",
  "bugs": {
    "url": "https://github.com/lukewalczak/rozenite-a11y/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lukewalczak/rozenite-a11y.git"
  },
  "keywords": [
    "rozenite",
    "rozenite-plugin",
    "react-native",
    "devtools",
    "accessibility",
    "a11y"
  ],
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "./dist/react-native/cjs/react-native.js",
  "module": "./dist/react-native/react-native.js",
  "types": "./dist/react-native/react-native.d.ts",
  "exports": {
    ".": {
      "types": "./dist/react-native/react-native.d.ts",
      "import": "./dist/react-native/react-native.js",
      "require": "./dist/react-native/cjs/react-native.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "rozenite build",
    "dev": "rozenite dev",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "oxlint --deny-warnings",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "test": "vitest --run",
    "prepublishOnly": "pnpm typecheck && pnpm test && pnpm build",
    "changeset": "changeset"
  },
  "dependencies": {
    "@rozenite/agent-bridge": "^2.5.0",
    "@rozenite/plugin-bridge": "^2.5.0"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^1.0.1",
    "@changesets/cli": "^3.0.3",
    "@rozenite/ui": "^2.5.0",
    "@rozenite/vite-plugin": "^2.5.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.20.5",
    "@types/react": "~19.1.10",
    "jsdom": "^31.0.1",
    "oxfmt": "^0.78.0",
    "oxlint": "^1.93.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-web": "^0.21.2",
    "rozenite": "^2.5.0",
    "typescript": "~5.9.3",
    "vite": "^7.3.1",
    "vitest": "^3.2.4"
  },
  "peerDependencies": {
    "react": "*",
    "react-native": "*"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@12.4.1"
}
